rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teacher() { return signedIn() && request.auth.token.get('teacher', false) == true; }
    function uid() { return request.auth.uid; }
    function attempt(id) { return getAfter(/databases/$(database)/documents/attempts/$(id)).data; }
    function player() { return getAfter(/databases/$(database)/documents/players/$(uid())).data; }
    function validScore(d) {
      return d.uid == uid()
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 30
        && d.name.matches("^[A-Za-z0-9\\p{L}\\p{M} ._'’\\-]{2,30}$")
        && d.avatar in ['sky', 'wind', 'sun', 'eco']
        && d.correct is int && d.correct >= 0 && d.correct <= 10
        && d.score is int && d.score >= d.correct * 100 && d.score <= d.correct * 120
        && d.answerMs is int && d.answerMs >= 0 && d.answerMs <= 31536000000
        && d.attemptId is string && d.attemptId.matches('^[a-f0-9-]{36}$');
    }
    function sameScore(a, b) {
      return a.uid == b.uid && a.name == b.name && a.avatar == b.avatar
        && a.correct == b.correct && a.score == b.score && a.answerMs == b.answerMs && a.attemptId == b.attemptId;
    }
    function better(a, b) {
      return a.correct > b.correct || (a.correct == b.correct && a.score > b.score)
        || (a.correct == b.correct && a.score == b.score && a.answerMs < b.answerMs);
    }
    match /attempts/{id} {
      allow get: if teacher() || (signedIn() && (!exists(/databases/$(database)/documents/attempts/$(id)) || resource.data.uid == uid()));
      allow list: if teacher() && request.query.limit != null && request.query.limit <= 1000;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'className', 'avatar', 'correct', 'score', 'answerMs', 'attemptId', 'completedAt'])
        && validScore(request.resource.data) && request.resource.data.attemptId == id
        && request.resource.data.className is string && request.resource.data.className.size() <= 40
        && request.resource.data.completedAt == request.time
        && player().lastAttemptId == id && player().lastSubmittedAt == request.time;
      allow update, delete: if false;
    }
    match /players/{id} {
      allow get: if signedIn() && uid() == id;
      allow list: if false;
      allow create, update: if signedIn() && uid() == id
        && request.resource.data.keys().hasOnly(['lastAttemptId', 'lastSubmittedAt'])
        && request.resource.data.lastSubmittedAt == request.time
        && request.resource.data.lastAttemptId is string
        && (!exists(/databases/$(database)/documents/players/$(id)) || request.time >= resource.data.lastSubmittedAt + duration.value(60, 's'))
        && !exists(/databases/$(database)/documents/attempts/$(request.resource.data.lastAttemptId))
        && attempt(request.resource.data.lastAttemptId).uid == uid()
        && attempt(request.resource.data.lastAttemptId).completedAt == request.time;
      allow delete: if false;
    }
    match /leaderboard/{id} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 10;
      allow create, update: if signedIn() && uid() == id
        && request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'correct', 'score', 'answerMs', 'attemptId'])
        && validScore(request.resource.data)
        && sameScore(request.resource.data, attempt(request.resource.data.attemptId))
        && player().lastAttemptId == request.resource.data.attemptId
        && player().lastSubmittedAt == request.time
        && (!exists(/databases/$(database)/documents/leaderboard/$(id)) || better(request.resource.data, resource.data));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
